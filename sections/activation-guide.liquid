{{ 'activation-guide.css' | asset_url | stylesheet_tag }}

<section class="ag-section">
  <div class="ag-container">
    <div class="ag-header">
      <h2 class="ag-title">{{ section.settings.heading }}</h2>
      <p class="ag-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="ag-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="ag-card" {{ block.shopify_attributes }}>
          <div class="ag-icon">
            {% case block.settings.icon %}
              {% when 'mac' %}
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                  <line x1="2" y1="20" x2="22" y2="20"></line>
                  <line x1="12" y1="16" x2="12" y2="20"></line>
                </svg>
              {% when 'windows' %}
                <svg viewBox="0 0 24 24">
                  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              {% when 'tv' %}
                <svg viewBox="0 0 24 24">
                  <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                  <polyline points="17 2 12 7 7 2"></polyline>
                </svg>
              {% when 'apple' %}
                <svg viewBox="0 0 24 24">
                  <!-- تفاحة آبل الرسمية -->
                  <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15.5 3.5c.67-.82 1.13-1.96.99-3.1-.98.04-2.17.65-2.87 1.48-.61.71-1.15 1.87-.99 2.97 1.09.08 2.2-.54 2.87-1.35z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'phone' %}
                <svg viewBox="0 0 24 24">
                  <rect x="6" y="2" width="12" height="20" rx="3"></rect>
                  <circle cx="12" cy="18" r="1" fill="currentColor"></circle>
                </svg>
            {% endcase %}
          </div>
          <span class="ag-name">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="ag-btn-wrapper">
        <a href="{{ section.settings.button_link | default: '#' }}" class="ag-btn">
          <span>{{ section.settings.button_text }}</span>
          <svg viewBox="0 0 24 24">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            <line x1="10" y1="6" x2="16" y2="6"></line>
            <line x1="10" y1="10" x2="16" y2="10"></line>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>




{% schema %}
{
    "name": "دليل التشغيل والأجهزة",
    "tag": "section",
    "class": "section-activation-guide",
    "disabled_on": {
    "groups": ["header", "footer"]
},

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي",
      "default": "كيف تشغّل اشتراكك؟"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "الوصف الفرعي",
      "default": "خطوات مبسّطة لكل جهاز"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "نص الزر",
      "default": "دليل التشغيل الكامل"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "رابط الزر"
    }
  ],
  "blocks": [
    {
      "type": "device",
      "name": "جهاز",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "اسم الجهاز",
          "default": "Android"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "الأيقونة",
          "options": [
            { "value": "mac", "label": "Mac" },
            { "value": "windows", "label": "Windows" },
            { "value": "tv", "label": "Smart TV (LG / Samsung)" },
            { "value": "apple", "label": "iPhone / Apple" },
            { "value": "phone", "label": "Android / Phone" }
          ],
          "default": "phone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "رابط صفحة الشرح"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "دليل التشغيل والأجهزة",
      "blocks": [
        { "type": "device", "settings": { "title": "Mac", "icon": "mac" } },
        { "type": "device", "settings": { "title": "Windows", "icon": "windows" } },
        { "type": "device", "settings": { "title": "LG TV", "icon": "tv" } },
        { "type": "device", "settings": { "title": "Samsung TV", "icon": "tv" } },
        { "type": "device", "settings": { "title": "iPhone", "icon": "apple" } },
        { "type": "device", "settings": { "title": "Android", "icon": "phone" } }
      ]
    }
  ]
}
{% endschema %}
