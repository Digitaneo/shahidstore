{{ 'bundle-feature.css' | asset_url | stylesheet_tag }}

{% assign bundle_product = section.settings.product %}

<section class="bundle-section">
  <div class="bundle-container">
    <div class="bundle-header">
      <div class="bundle-header-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 12 20 22 4 22 4 12"></polyline>
          <rect x="2" y="7" width="20" height="5"></rect>
          <line x1="12" y1="22" x2="12" y2="7"></line>
          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
          <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
        </svg>
      </div>
      <div class="bundle-header-text">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>

    <div class="bundle-card">
      <div class="bundle-content">
        <div>
          <h3 class="bundle-title">
            {% if bundle_product != blank %}{{ bundle_product.title }}{% else %}{{ section.settings.title }}{% endif %}
          </h3>
          
          <div class="bundle-badge">
            <span>🔥</span>
            <span>{{ section.settings.buyers_count }}</span>
          </div>

          <div class="bundle-includes">
            <span class="bundle-includes-label">داخل المجموعة</span>
            <div class="bundle-includes-items">
              {% if section.settings.item1_title != blank %}
                <div class="bundle-mini-item">
                  {% if section.settings.item1_logo != blank %}
                    <img src="{{ section.settings.item1_logo | image_url: width: 60 }}" alt="{{ section.settings.item1_title }}" class="bundle-mini-logo">
                  {% endif %}
                  <div class="bundle-mini-info">
                    <h4>{{ section.settings.item1_title }}</h4>
                    <span>{{ section.settings.item1_subtitle }}</span>
                  </div>
                </div>
              {% endif %}

              {% if section.settings.item2_title != blank %}
                <div class="bundle-mini-item">
                  {% if section.settings.item2_logo != blank %}
                    <img src="{{ section.settings.item2_logo | image_url: width: 60 }}" alt="{{ section.settings.item2_title }}" class="bundle-mini-logo">
                  {% endif %}
                  <div class="bundle-mini-info">
                    <h4>{{ section.settings.item2_title }}</h4>
                    <span>{{ section.settings.item2_subtitle }}</span>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>

          <ul class="bundle-features">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div>
          <div class="bundle-pricing-row">
            <div class="bundle-prices">
              <span class="bundle-price-current">
                {% if bundle_product != blank %}{{ bundle_product.price | money }}{% else %}{{ section.settings.price }}{% endif %}
              </span>
              {% if bundle_product.compare_at_price > bundle_product.price or section.settings.compare_price != blank %}
                <span class="bundle-price-compare">
                  {% if bundle_product != blank %}{{ bundle_product.compare_at_price | money }}{% else %}{{ section.settings.compare_price }}{% endif %}
                </span>
              {% endif %}
            </div>
            <div class="bundle-guarantees">
              <span>⚡ تفعيل سريع</span>
              <span>🛡️ ضمان استبدال</span>
            </div>
          </div>

          <a href="{% if bundle_product != blank %}{{ bundle_product.url }}{% else %}#{% endif %}" class="bundle-btn">
            <span>✨ {{ section.settings.button_text }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div class="bundle-media">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}" loading="lazy">
        {% elsif bundle_product.featured_image != blank %}
          <img src="{{ bundle_product.featured_image | image_url: width: 800 }}" alt="{{ bundle_product.title }}" loading="lazy">
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "مجموعات سنوية مميّزة",
  "tag": "section",
  "class": "section-bundle-feature",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي",
      "default": "مجموعات سنوية مميّزة"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "الوصف الفرعي",
      "default": "مجموعات مدمجة بسعر مميّز وقيمة مضاعفة"
    },
    {
      "type": "product",
      "id": "product",
      "label": "المنتج المستهدف (العرض)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "صورة العرض الترويجية"
    },
    {
      "type": "text",
      "id": "title",
      "label": "عنوان العرض (في حال لم يتم تحديد منتج)",
      "default": "فالكون + هولك — سنة كاملة"
    },
    {
      "type": "text",
      "id": "buyers_count",
      "label": "عدد المشترين",
      "default": "95 مشتري اختار هذه المجموعة"
    },
    {
      "type": "header",
      "content": "الاشتراك الأول داخل المجموعة"
    },
    {
      "type": "text",
      "id": "item1_title",
      "label": "اسم الاشتراك الأول",
      "default": "فالكون"
    },
    {
      "type": "text",
      "id": "item1_subtitle",
      "label": "المدة",
      "default": "سنة كاملة"
    },
    {
      "type": "image_picker",
      "id": "item1_logo",
      "label": "شعار الاشتراك الأول"
    },
    {
      "type": "header",
      "content": "الاشتراك الثاني داخل المجموعة"
    },
    {
      "type": "text",
      "id": "item2_title",
      "label": "اسم الاشتراك الثاني",
      "default": "هولك"
    },
    {
      "type": "text",
      "id": "item2_subtitle",
      "label": "المدة",
      "default": "سنة كاملة"
    },
    {
      "type": "image_picker",
      "id": "item2_logo",
      "label": "شعار الاشتراك الثاني"
    },
    {
      "type": "header",
      "content": "السعر وزر الطلب"
    },
    {
      "type": "text",
      "id": "price",
      "label": "السعر المخصص",
      "default": "399 ر.س"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "السعر قبل الخصم",
      "default": "550 ر.س"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "نص الزر",
      "default": "اشترك الآن"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "ميزة",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "نص الميزة",
          "default": "اشتراك فالكون سنة كاملة"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "مجموعات سنوية مميّزة",
      "blocks": [
        { "type": "feature", "settings": { "text": "اشتراك فالكون سنة كاملة" } },
        { "type": "feature", "settings": { "text": "اشتراك هولك سنة كاملة" } },
        { "type": "feature", "settings": { "text": "تغطية محتوى مضاعفة بسعر واحد" } },
        { "type": "feature", "settings": { "text": "قنوات رياضية وكأس العالم للمنتخبات بجودة 4K" } }
      ]
    }
  ]
}
{% endschema %}
