{{ 'contact-form.css' | asset_url | stylesheet_tag }}

<section class="contact-section">
  <div class="contact-container">
    
    <!-- رأس الصفحة -->
    <div class="contact-header">
      <h1 class="contact-title">{{ section.settings.heading }}</h1>
      <p class="contact-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- شريط الانضمام لقناة تلجرام -->
    {% if section.settings.telegram_url != blank %}
      <a href="{{ section.settings.telegram_url }}" target="_blank" rel="noopener" class="contact-tg-card">
        <div class="contact-tg-info">
          <span class="contact-tg-label">{{ section.settings.telegram_label }}</span>
          <span class="contact-tg-title">{{ section.settings.telegram_text }}</span>
        </div>
        <div class="contact-tg-icon">
          <svg viewBox="0 0 24 24">
            <path d="M21.6 3.2L2.5 10.6c-1.3.5-1.3 1.3-.2 1.6l4.9 1.5 1.7 5.2c.2.6.4.8.9.8.7 0 1-.3 1.4-.7l2.4-2.3 5 3.7c.9.5 1.6.3 1.9-.8l3.3-15.6c.3-1.3-.5-1.9-1.9-1.2z"/>
          </svg>
        </div>
      </a>
    {% endif %}

    <!-- بطاقة نموذج الاستفسار -->
    <div class="contact-card">
      <h2 class="contact-form-title">{{ section.settings.form_title }}</h2>

      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <div class="contact-feedback success">
            تم إرسال استفسارك بنجاح! سنتواصل معك عبر البريد الإلكتروني في أقرب وقت.
          </div>
        {% elsif form.errors %}
          <div class="contact-feedback error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-row">
          <!-- الاسم (على اليمين) -->
          <div class="contact-field">
            <label for="ContactFormName">الاسم</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="contact-input" placeholder="اسمك الكريم" value="{% if form.name %}{{ form.name }}{% endif %}" required>
          </div>

          <!-- البريد الإلكتروني (على اليسار) -->
          <div class="contact-field">
            <label for="ContactFormEmail">البريد الإلكتروني</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="contact-input" placeholder="example@gmail.com" dir="ltr" style="text-align: right;" value="{% if form.email %}{{ form.email }}{% endif %}" required autocorrect="off" autocapitalize="off">
          </div>
        </div>

        <!-- الموضوع -->
        <div class="contact-field">
          <label for="ContactFormSubject">الموضوع</label>
          <input type="text" id="ContactFormSubject" name="contact[الموضوع]" class="contact-input" placeholder="استفسار عن باقة / مشكلة في طلب / اقتراح">
        </div>

        <!-- نص الرسالة -->
        <div class="contact-field">
          <label for="ContactFormMessage">الرسالة</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" class="contact-textarea" placeholder="اكتب تفاصيل استفسارك هنا..." required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <!-- زر الإرسال -->
        <button type="submit" class="contact-submit-btn">
          {{ section.settings.submit_text }}
        </button>
      {% endform %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "صفحة التواصل",
  "tag": "section",
  "class": "section-main-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي",
      "default": "تواصل معنا"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "الوصف الفرعي",
      "default": "متاحون لك يومياً عبر النموذج أدناه أو قناة تلجرام."
    },
    {
      "type": "header",
      "content": "إعدادات قناة تلجرام"
    },
    {
      "type": "text",
      "id": "telegram_label",
      "label": "النص المصغر",
      "default": "تلجرام"
    },
    {
      "type": "text",
      "id": "telegram_text",
      "label": "النص الرئيسي",
      "default": "انضم إلى القناة"
    },
    {
      "type": "url",
      "id": "telegram_url",
      "label": "رابط قناة تلجرام"
    },
    {
      "type": "header",
      "content": "إعدادات النموذج"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "عنوان النموذج",
      "default": "أرسل استفسارك"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "نص زر الإرسال",
      "default": "إرسال الاستفسار"
    }
  ],
  "presets": [
    {
      "name": "صفحة التواصل"
    }
  ]
}
{% endschema %}
