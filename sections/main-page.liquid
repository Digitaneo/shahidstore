{{ 'main-page.css' | asset_url | stylesheet_tag }}

<section class="page-section">
  <div class="page-container">
    <div class="page-header">
      <h1 class="page-title">{{ page.title }}</h1>
    </div>

    <div class="page-rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "محتوى الصفحة",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
