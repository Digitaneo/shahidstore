{{ 'shahidstore-banner.css' | asset_url | stylesheet_tag }}

<div class="shahidstore-slideshow-container" 
     id="Slideshow-{{ section.id }}" 
     data-autoplay-interval="{{ section.settings.autoplay_speed | multiply: 1000 }}"
     {{ section.shopify_attributes }}>
  
  <div class="shahidstore-slideshow-inner">
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        <div class="shahidstore-slide-item {% if forloop.first %}is-active{% endif %}" 
             data-index="{{ forloop.index0 }}" 
             {{ block.shopify_attributes }}>
          
          {% if block.settings.desktop_image != blank %}
            <img src="{{ block.settings.desktop_image | image_url: width: 1800 }}" 
                 srcset="{{ block.settings.desktop_image | image_url: width: 600 }} 600w, 
                         {{ block.settings.desktop_image | image_url: width: 1200 }} 1200w, 
                         {{ block.settings.desktop_image | image_url: width: 1800 }} 1800w"
                 sizes="100vw"
                 alt="{{ block.settings.title | escape }}"
                 class="shahidstore-slide-bg shahidstore-desktop-only-bg"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                 fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}">
          {% else %}
            {%- comment -%} Placeholder banner if no image is uploaded {%- endcomment -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'shahidstore-slide-bg shahidstore-desktop-only-bg' }}
          {% endif %}

          {% if block.settings.mobile_image != blank %}
            <img src="{{ block.settings.mobile_image | image_url: width: 800 }}" 
                 srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w, 
                         {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
                 sizes="100vw"
                 alt="{{ block.settings.title | escape }}"
                 class="shahidstore-slide-bg shahidstore-mobile-only-bg"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% else %}
            {% if block.settings.desktop_image != blank %}
              <img src="{{ block.settings.desktop_image | image_url: width: 800 }}" 
                   alt="{{ block.settings.title | escape }}"
                   class="shahidstore-slide-bg shahidstore-mobile-only-bg"
                   loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'shahidstore-slide-bg shahidstore-mobile-only-bg' }}
            {% endif %}
          {% endif %}

          <div class="shahidstore-slide-overlay">
            <div class="shahidstore-slide-content">
              <h2 class="shahidstore-slide-title">{{ block.settings.title | escape | newline_to_br }}</h2>
              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link | default: '#' }}" 
                   class="shahidstore-slide-button"
                   style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }}; border-radius: {{ block.settings.button_border_radius }}px;">
                  {{ block.settings.button_text | escape }}
                </a>
              {% endif %}
            </div>
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="shahidstore-slideshow-dots">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button class="shahidstore-slideshow-dot {% if forloop.first %}is-active{% endif %}" 
                  data-index="{{ forloop.index0 }}"
                  aria-label="عرض الشريحة {{ forloop.index }}">
          </button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('Slideshow-{{ section.id }}');
  if (!container) return;
  
  const slides = container.querySelectorAll('.shahidstore-slide-item');
  const dots = container.querySelectorAll('.shahidstore-slideshow-dot');
  let currentIndex = 0;
  const intervalTime = parseInt(container.dataset.autoplayInterval) || 5000;
  let timer;

  function showSlide(index) {
    if (slides.length === 0) return;
    slides.forEach(s => s.classList.remove('is-active'));
    dots.forEach(d => d.classList.remove('is-active'));
    
    slides[index].classList.add('is-active');
    if (dots[index]) dots[index].classList.add('is-active');
    currentIndex = index;
  }

  function nextSlide() {
    let nextIndex = (currentIndex + 1) % slides.length;
    showSlide(nextIndex);
  }

  function startAutoplay() {
    if (slides.length <= 1) return;
    timer = setInterval(nextSlide, intervalTime);
  }

  function resetAutoplay() {
    clearInterval(timer);
    startAutoplay();
  }

  dots.forEach(dot => {
    dot.addEventListener('click', function() {
      const idx = parseInt(this.dataset.index);
      showSlide(idx);
      resetAutoplay();
    });
  });

  // Shopify Customize Editor event listeners
  document.addEventListener('shopify:block:select', function(e) {
    if (e.target.classList.contains('shahidstore-slide-item')) {
      clearInterval(timer);
      const idx = Array.from(slides).indexOf(e.target);
      if (idx > -1) {
        showSlide(idx);
      }
    }
  });

  document.addEventListener('shopify:block:deselect', function() {
    resetAutoplay();
  });

  // Initialize first slide and start timer
  showSlide(0);
  startAutoplay();
});
</script>

{% schema %}
{
  "name": "البانر المتحرك (Slideshow Banner)",
  "tag": "section",
  "class": "section-slideshow-banner",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "سرعة التنقل التلقائي (بالثواني)",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "شريحة بانر",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "صورة البانر للكمبيوتر (المقاس المقترح: 1920x600)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "صورة البانر للهواتف (المقاس المقترح: 750x450)"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "عنوان الشريحة",
          "default": "اشترك الآن واستمتع دون توقف"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "نص الزر",
          "default": "اشترك الآن"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "رابط الزر"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "لون الزر الخلفي",
          "default": "#e0ac00"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "لون نص الزر",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "button_border_radius",
          "min": 0,
          "max": 50,
          "step": 2,
          "unit": "px",
          "label": "زوايا حواف الزر",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "البانر المتحرك (Slideshow Banner)",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "اشترك الآن واستمتع دون توقف",
            "button_text": "اشترك الآن"
          }
        }
      ]
    }
  ]
}
{% endschema %}
