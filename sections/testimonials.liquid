{{ 'testimonials.css' | asset_url | stylesheet_tag }}

<section class="testimonials-section">
  <div class="testimonials-container">
    
    <!-- رأس القسم -->
    <div class="testimonials-header">
      {% if section.settings.pill_text != blank %}
        <span class="testimonials-pill">{{ section.settings.pill_text }}</span>
      {% endif %}

      <div class="testimonials-stars-main">
        {% for i in (1..5) %}
          <svg viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        {% endfor %}
      </div>

      <h2 class="testimonials-title">{{ section.settings.heading }}</h2>
      <p class="testimonials-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- شبكة التقييمات -->
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div>
            <div class="testimonial-stars">
              {% assign stars_count = block.settings.rating | default: 5 %}
              {% for i in (1..stars_count) %}
                <svg viewBox="0 0 24 24">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {% endfor %}
            </div>

            <p class="testimonial-quote">"{{ block.settings.quote }}"</p>
          </div>

          <div class="testimonial-author">
            <div class="testimonial-info">
              <span class="testimonial-name">{{ block.settings.author_name }}</span>
              <span class="testimonial-meta">{{ block.settings.location }} • {{ block.settings.plan_info }}</span>
            </div>

            <div class="testimonial-avatar-letter">
              {{ block.settings.avatar_letter | default: block.settings.author_name | slice: 0 }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "آراء وتقييمات العملاء",
  "tag": "section",
  "class": "section-testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "النص الترويجي العلوي",
      "default": "تجارب موثّقة"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "عنوان القسم الرئيسي",
      "default": "ماذا قال عملاؤنا"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "الوصف الفرعي",
      "default": "تجارب حقيقية من مشتركين في شاهد ستور"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "تقييم عميل",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "عدد النجوم",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "نص التقييم",
          "default": "تجربة جيدة جدا، التفعيل كان سريع جداً والقنوات شغّالة بدون أي مشاكل."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "اسم العميل",
          "default": "أحمد ع."
        },
        {
          "type": "text",
          "id": "avatar_letter",
          "label": "الحرف الرمزي (اختياري)",
          "default": "أ"
        },
        {
          "type": "text",
          "id": "location",
          "label": "المدينة / الدولة",
          "default": "الرياض"
        },
        {
          "type": "text",
          "id": "plan_info",
          "label": "الخطة / نوع الاشتراك",
          "default": "فالكون سنة"
        }
