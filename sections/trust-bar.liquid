{{ 'trust-bar.css' | asset_url | stylesheet_tag }}

<div class="tb-section">
  <div class="tb-container">
    <div class="tb-wrapper">
      
      <!-- قسم الأجهزة المدعومة -->
      <div class="tb-group">
        <span class="tb-label">{{ section.settings.devices_label }}</span>
        <div class="tb-items">
          <!-- 1. تلفاز / شاشة -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>

          <!-- 2. Apple TV / رسيفر ذكي -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <rect x="2" y="6" width="20" height="12" rx="3"></rect>
              <path d="M12 9.5c0-.8.7-1.5 1.5-1.5.3 0 .6.1.8.3-.3.4-.8.7-1.3.7-.4 0-.7-.2-.9-.5a1.5 1.5 0 0 1-.1-1" stroke-width="1.2"></path>
              <circle cx="8" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
          </div>

          <!-- 3. هاتف جوال -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <rect x="6" y="2" width="12" height="20" rx="3"></rect>
              <circle cx="12" cy="18" r="1" fill="currentColor"></circle>
            </svg>
          </div>

          <!-- 4. روبوت أندرويد (الرسمي الدقيق) -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <!-- الرأس -->
              <path d="M5 14a7 7 0 0 1 14 0H5z"></path>
              <!-- قرون الاستشعار -->
              <line x1="7.5" y1="8" x2="6" y2="5.5"></line>
              <line x1="16.5" y1="8" x2="18" y2="5.5"></line>
              <!-- العينان -->
              <circle cx="9" cy="11.5" r="0.8" fill="currentColor"></circle>
              <circle cx="15" cy="11.5" r="0.8" fill="currentColor"></circle>
            </svg>
          </div>

          <!-- 5. TV Stick / وصلة التلفاز -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="9" width="13" height="6" rx="2"></rect>
              <line x1="16" y1="10.5" x2="20" y2="10.5"></line>
              <line x1="16" y1="13.5" x2="20" y2="13.5"></line>
            </svg>
          </div>

          <!-- 6. متصفح / ويب -->
          <div class="tb-box">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"></circle>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <path d="M12 3a14.5 14.5 0 0 1 4 9 14.5 14.5 0 0 1-4 9 14.5 14.5 0 0 1-4-9 14.5 14.5 0 0 1 4-9z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- الفاصل الرأسي -->
      <div class="tb-divider"></div>

      <!-- قسم طرق الدفع -->
      <div class="tb-group">
        <div class="tb-items">
          <!-- Mastercard -->
          <div class="tb-box">
            <svg width="34" height="20" viewBox="0 0 36 22">
              <circle cx="12" cy="11" r="10" fill="#EB001B"/>
              <circle cx="24" cy="11" r="10" fill="#F79E1B" fill-opacity="0.9"/>
            </svg>
          </div>

          <!-- VISA الرسمية -->
          <div class="tb-box">
            <svg width="44" height="15" viewBox="0 0 60 20" fill="none">
              <path d="M24.7 19.3L28.1 0.7H22.7L19.3 19.3H24.7ZM43.3 1.2C42.2 0.7 40.5 0.3 38.3 0.3C32.8 0.3 28.9 3.2 28.9 7.4C28.9 10.5 31.7 12.2 33.8 13.2C36 14.3 36.7 15 36.7 16C36.7 17.5 34.9 18.2 33.2 18.2C30.9 18.2 29.5 17.8 27.9 17.1L27.1 16.7L26.2 21.8C27.6 22.4 30.1 23 32.7 23C38.6 23 42.4 20.1 42.4 15.6C42.4 12 40.2 10.3 37.8 9.1C36 8.2 34.8 7.6 34.8 6.6C34.8 5.7 35.8 4.8 38 4.8C39.8 4.8 41.2 5.2 42.2 5.7L42.7 5.9L43.3 1.2ZM56.1 0.7H51.9C50.6 0.7 49.6 1.1 49 2.5L41.9 19.3H47.6L48.7 16.1H55.7L56.4 19.3H61.4L56.1 0.7ZM50.3 11.9L53.2 4.1L54.9 11.9H50.3ZM16.4 0.7L11.2 13.8L9.1 2.6C8.8 1.1 7.6 0.7 6.3 0.7H0.2L0 1.6C1.3 1.9 2.8 2.4 3.7 2.9C4.3 3.2 4.5 3.6 4.7 4.5L8.4 19.3H14.1L22.1 0.7H16.4Z" fill="#FFFFFF"/>
            </svg>
          </div>

          <!-- mada الرسمية -->
          <div class="tb-box">
            <svg width="46" height="18" viewBox="0 0 85 30" fill="none">
              <!-- m -->
              <path d="M0 26.5V9.8H4.8V12.4C6.1 10.4 8.7 9.4 11.2 9.4C13.8 9.4 15.9 10.5 16.9 12.6C18.4 10.5 21.1 9.4 23.9 9.4C28.2 9.4 31 12.1 31 17V26.5H26.2V17.5C26.2 14.5 24.6 13.2 22.4 13.2C20.1 13.2 18.5 14.7 18.5 17.7V26.5H13.7V17.5C13.7 14.5 12.1 13.2 9.9 13.2C7.6 13.2 6 14.7 6 17.7V26.5H0Z" fill="#00A3E0"/>
              <!-- ada -->
              <path d="M42.2 26.5V23.9C40.9 25.9 38.3 26.9 35.8 26.9C31.5 26.9 28.7 24.2 28.7 19.3C28.7 14.4 31.5 11.7 35.8 11.7C38.3 11.7 40.9 12.7 42.2 14.7V12.1H47V26.5H42.2ZM37.9 15.5C35.6 15.5 34 17 34 20C34 23 35.6 24.5 37.9 24.5C40.2 24.5 41.8 23 41.8 20C41.8 17 40.2 15.5 37.9 15.5Z" fill="#8BC53F"/>
              <path d="M57.6 26.5V23.9C56.3 25.9 53.7 26.9 51.2 26.9C46.9 26.9 44.1 24.2 44.1 19.3C44.1 14.4 46.9 11.7 51.2 11.7C53.7 11.7 56.3 12.7 57.6 14.7V4H62.4V26.5H57.6ZM53.3 15.5C51 15.5 49.4 17 49.4 20C49.4 23 51 24.5 53.3 24.5C55.6 24.5 57.2 23 57.2 20C57.2 17 55.6 15.5 53.3 15.5Z" fill="#8BC53F"/>
              <path d="M73 26.5V23.9C71.7 25.9 69.1 26.9 66.6 26.9C62.3 26.9 59.5 24.2 59.5 19.3C59.5 14.4 62.3 11.7 66.6 11.7C69.1 11.7 71.7 12.7 73 14.7V12.1H77.8V26.5H73ZM68.7 15.5C66.4 15.5 64.8 17 64.8 20C64.8 23 66.4 24.5 68.7 24.5C71 24.5 72.6 23 72.6 20C72.6 17 71 15.5 68.7 15.5Z" fill="#8BC53F"/>
            </svg>
          </div>
        </div>
        <span class="tb-label">{{ section.settings.payments_label }}</span>
      </div>

    </div>
  </div>
</div>


{% schema %}
{
    "name": "شريط الأجهزة وطرق الدفع",
    "disabled_on": {
    "groups": ["header", "footer"]
},
"tag": "section",
"class": "section-trust-bar",
"settings": [
    {
      "type": "text",
      "id": "devices_label",
      "label": "نص قسم الأجهزة",
      "default": "يعمل على"
    },
    {
      "type": "text",
      "id": "payments_label",
      "label": "نص قسم الدفع",
      "default": "طرق دفع آمنة"
    }
  ],
  "presets": [
    {
      "name": "شريط الأجهزة وطرق الدفع"
    }
  ]
}
{% endschema %}